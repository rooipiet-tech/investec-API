# ── Investec Open API (read-only client-credentials) ───────────────────────────
# Obtain from the Investec Online portal → Programmable Banking → Enrolled APIs.
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=
INVESTEC_BASE_URL=https://openapi.investec.com

# ── Supabase / Postgres ─────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI).
# Use the connection pooler URI and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# ── Reporting / email (Gmail SMTP + app password) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
REPORT_SENDER=you@gmail.com
# Comma-separated list of recipients.
REPORT_RECIPIENTS=you@gmail.com

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Days of history each ingest run pulls (overlap window heals late postings).
INGEST_WINDOW_DAYS=7

# ── Backup (optional) ─────────────────────────────────────────────────────────
# If set, the weekly pg_dump is encrypted with openssl AES-256 before it is
# uploaded as a CI artifact. Leave blank for a gzip-only (unencrypted) dump.
BACKUP_PASSPHRASE=
