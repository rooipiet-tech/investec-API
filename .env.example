# ── Investec Open API (read-only client-credentials) ───────────────────────────
# Obtain from the Investec Online portal → Programmable Banking → Enrolled APIs.
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=
INVESTEC_BASE_URL=https://openapi.investec.com

# ── Supabase / Postgres ─────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI).
# Use the connection pooler URI and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Optional: a read-only role scoped to the analytical views, used by the report
# (least privilege — see db/roles.sql). Falls back to DATABASE_URL when unset.
REPORT_DATABASE_URL=

# ── Reporting / email ─────────────────────────────────────────────────────────
# Option A — Gmail API (recommended, no app-password needed):
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0
#      Client ID (type: Desktop app).  Download the JSON, copy client_id /
#      client_secret below.
#   2. Run once locally to get a refresh token:
#        python - <<'EOF'
#        from google_auth_oauthlib.flow import InstalledAppFlow
#        flow = InstalledAppFlow.from_client_secrets_file(
#            'client_secret.json', scopes=['https://www.googleapis.com/auth/gmail.send'])
#        creds = flow.run_local_server(port=0)
#        print(creds.refresh_token)
#        EOF
#   3. Store the printed token as GMAIL_REFRESH_TOKEN (GitHub secret in CI).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
REPORT_SENDER=you@gmail.com
# Comma-separated list of recipients.
REPORT_RECIPIENTS=you@gmail.com

# Option B — Gmail SMTP (app password fallback, used when GMAIL_* vars are unset):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Days of history each ingest run pulls (overlap window heals late postings).
INGEST_WINDOW_DAYS=7

# ── Backup (optional) ─────────────────────────────────────────────────────────
# If set, the weekly pg_dump is encrypted with openssl AES-256 before it is
# uploaded as a CI artifact. Leave blank for a gzip-only (unencrypted) dump.
BACKUP_PASSPHRASE=
