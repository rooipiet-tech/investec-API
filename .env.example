# ── Investec Open API (read-only client-credentials) ───────────────────────────
# Obtain from the Investec Online portal → Programmable Banking → Enrolled APIs.
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=
INVESTEC_BASE_URL=https://openapi.investec.com

# ── Supabase / Postgres ─────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI).
# Use the connection pooler URI and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Optional: a read-only role scoped to the analytical views, used by the report
# (least privilege — see db/roles.sql). Falls back to DATABASE_URL when unset.
REPORT_DATABASE_URL=

# ── Reporting / email ─────────────────────────────────────────────────────────
# Option A — Gmail API (recommended, no app-password needed):
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0
#      Client ID (type: Desktop app).  Download its JSON.
#   2. Enable the Gmail API for the project, and add the scope
#      https://www.googleapis.com/auth/gmail.send under Data Access.
#   3. Mint a refresh token (one time):
#        pip install google-auth-oauthlib
#        python scripts/get_gmail_token.py path/to/client_secret_xxx.json
#      It prints GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET / GMAIL_REFRESH_TOKEN.
#   Tip: publish the OAuth consent screen to "Production" so the refresh token
#   does not expire after 7 days (Testing mode).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
REPORT_SENDER=you@gmail.com
# Comma-separated list of recipients.
REPORT_RECIPIENTS=you@gmail.com

# Option B — Gmail SMTP (app password fallback, used when GMAIL_* vars are unset):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Days of history each ingest run pulls (overlap window heals late postings).
INGEST_WINDOW_DAYS=7

# ── Backup (optional) ─────────────────────────────────────────────────────────
# If set, the weekly pg_dump is encrypted with openssl AES-256 before it is
# uploaded as a CI artifact. Leave blank for a gzip-only (unencrypted) dump.
BACKUP_PASSPHRASE=
