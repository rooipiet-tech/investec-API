# ── Investec Open API (read-only client-credentials) ───────────────────────────
# Obtain from the Investec Online portal → Programmable Banking → Enrolled APIs.
INVESTEC_CLIENT_ID=
INVESTEC_CLIENT_SECRET=
INVESTEC_API_KEY=
INVESTEC_BASE_URL=https://openapi.investec.com

# ── Supabase / Postgres ─────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI).
# Use the connection pooler URI and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# Optional: a read-only role scoped to the analytical views, used by the report
# (least privilege — see db/roles.sql). Falls back to DATABASE_URL when unset.
REPORT_DATABASE_URL=

# ── Reporting / email (Gmail SMTP + app password) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
REPORT_SENDER=you@gmail.com
# Default recipients (comma-separated) for accounts not claimed by any group below.
REPORT_RECIPIENTS=you@gmail.com

# ── Account filtering / grouping ──────────────────────────────────────────────────
# Groupings and exclusions are configured in code — edit src/invespend/groups.py.
# No env vars or secrets needed for this.

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Days of history each ingest run pulls (overlap window heals late postings).
INGEST_WINDOW_DAYS=7

# ── Backup (optional) ─────────────────────────────────────────────────────────
# If set, the weekly pg_dump is encrypted with openssl AES-256 before it is
# uploaded as a CI artifact. Leave blank for a gzip-only (unencrypted) dump.
BACKUP_PASSPHRASE=

# ── Email-payment-approval (optional; DRY-RUN by default) ─────────────────────
# HMAC key that signs single-use approval tokens. Never logged/emailed. PLACEHOLDER.
APPROVAL_SIGNING_SECRET=change_me_long_random_secret
# Spending caps (0 = fail-closed: no payment passes until you set these).
PER_PAYMENT_CAP=0
DAILY_AGGREGATE_CAP=0
# DRY-RUN is the default. Live money movement needs BOTH the flag below set true
# AND a complete write-scoped Investec credential set.
PAYMENTS_DRY_RUN=true
PAYMENTS_LIVE_ENABLE=false
# Write-scoped Investec credential (leave blank to stay dry-run). PLACEHOLDERS.
INVESTEC_WRITE_CLIENT_ID=
INVESTEC_WRITE_CLIENT_SECRET=
INVESTEC_WRITE_API_KEY=
# IMAP inbox to read approval replies from. PLACEHOLDERS.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASSWORD=your_16_char_app_password
IMAP_MAILBOX=INBOX
# POPIA retention window (days) for pending/audit cleanup.
RETENTION_DAYS=90
# Where pending/daily-total/audit JSON state is persisted.
PAYMENTS_STATE_DIR=.invespend_state
